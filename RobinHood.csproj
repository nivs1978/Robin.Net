<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier Condition="'$(RuntimeIdentifier)' == ''">win-x64</RuntimeIdentifier>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <!-- The x64 SDL2.dll shipped with this project (see native/README.md). Override with -p:SdlNativePath=... -->
    <SdlNativePath Condition="'$(SdlNativePath)' == ''">$(MSBuildProjectDirectory)\native\win-x64\SDL2.dll</SdlNativePath>
  </PropertyGroup>
  <ItemGroup Condition="Exists('$(SdlNativePath)')">
    <None Include="$(SdlNativePath)" Link="SDL2.dll" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="NukedOPL3Sharp" Version="1.3.1" GeneratePathProperty="true" />
  </ItemGroup>
  <ItemGroup>
    <None Include="README.md" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgNukedOPL3Sharp)\LICENSE" Link="NukedOPL3Sharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <None Include="$(PkgNukedOPL3Sharp)\THIRD_PARTY_NOTICES.md" Link="NukedOPL3Sharp-NOTICES.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <None Update="native\win-x64\SDL2.dll">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <Folder Include="obj\QuitProbe\" />
  </ItemGroup>
  <Target Name="RequireSdl" BeforeTargets="Build" Condition="!Exists('$(SdlNativePath)')">
    <Warning Text="SDL2.dll was not found at $(SdlNativePath); the game cannot start without an x64 SDL2.dll next to the executable." />
  </Target>
</Project>
